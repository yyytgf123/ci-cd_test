<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- CVE-2025-7962: Jakarta Mail SMTP Injection
         실제 취약 컴포넌트는 org.eclipse.angus:smtp / jakarta.mail (2.0.4+로 수정됨)
         angus-activation은 메일 전송과 무관한 오탐(FP)으로 공식 보고됨 -->
    <suppress>
        <notes>CVE-2025-7962 FP on angus-activation. Affected component is org.eclipse.angus:smtp, not activation.</notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus\-activation@.*$</packageUrl>
        <cve>CVE-2025-7962</cve>
    </suppress>
</suppressions>
